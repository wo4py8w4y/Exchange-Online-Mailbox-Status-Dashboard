<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Allow backup status manifest" stopProcessing="true">
                    <match url="^Backups/backup-status\.json$" ignoreCase="true" />
                    <action type="None" />
                </rule>
                <rule name="Allow timestamped backup copies" stopProcessing="true">
                    <match url="^Backups/MailboxDashboard_\d{8}T\d{9}Z/(history|data)\.json$" ignoreCase="true" />
                    <action type="None" />
                </rule>
                <rule name="Deny other backup paths" stopProcessing="true">
                    <match url="^Backups(?:/.*)?$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
            </rules>
        </rewrite>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>
    </system.webServer>
    <location path="Backups">
        <system.webServer>
            <directoryBrowse enabled="false" />
            <staticContent>
                <remove fileExtension=".json" />
                <mimeMap fileExtension=".json" mimeType="application/json" />
            </staticContent>
            <security>
                <requestFiltering>
                    <fileExtensions allowUnlisted="false">
                        <clear />
                        <add fileExtension=".json" allowed="true" />
                    </fileExtensions>
                </requestFiltering>
            </security>
        </system.webServer>
    </location>
</configuration>
