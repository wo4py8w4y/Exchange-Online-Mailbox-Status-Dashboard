		//"window.inactiveBorder": null
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#A78BFA",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#D946EF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.operator.new",
				"keyword.other.important"
			],
			"settings": {
				"foreground": "#FF0080",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#00FFFF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#C084FC",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#00FF88"
			}
		},
		{
			"scope": [
				"string.template",
				"meta.template.expression",
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#22D3EE",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null"
			],
			"settings": {
				"foreground": "#FF9500"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other.readwrite",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#A5F3FC"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#38BDF8"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#FB7185"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.arithmetic",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#A855F7"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator"
			],
			"settings": {
				"foreground": "#FDE047"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#FF006E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#06B6D4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.tag.css",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#8B5CF6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.type.property-name.css"
			],
			"settings": {
				"foreground": "#3B82F6"
			}
		},
		{
			"scope": [
				"support.constant.property-value.css",
				"meta.property-value.css"
			],
			"settings": {
				"foreground": "#84CC16"
			}
		},
		{
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#F472B6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable.language.this",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#FF8800",
				"fontStyle": "italic bold"
			}
		},
		{
			"scope": [
				"entity.name.function.decorator",
				"meta.decorator"
			],
			"settings": {
				"foreground": "#FBBF24",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#A3E635",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#FFFF00",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#22D3EE",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.heading.1"
			],
			"settings": {
				"foreground": "#FF0080",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.heading.2"
			],
			"settings": {
				"foreground": "#D946EF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.heading.3"
			],
			"settings": {
				"foreground": "#C084FC",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.heading.4",
				"markup.heading.5",
				"markup.heading.6"
			],
			"settings": {
				"foreground": "#A78BFA",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#FF006E",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#2DD4BF",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#00FF88"
			}
		},
		{
			"scope": [
				"markup.underline.link"
			],
			"settings": {
				"foreground": "#0EA5E9"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#A855F7",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#14B8A6",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.type.enum"
			],
			"settings": {
				"foreground": "#F59E0B",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"entity.name.type.module"
			],
			"settings": {
				"foreground": "#6366F1",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"support.constant"
			],
			"settings": {
				"foreground": "#FACC15"
			}
		},
		{
			"scope": [
				"meta.tag.metadata",
				"entity.name.tag.metadata"
			],
			"settings": {
				"foreground": "#84CC16"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#FF3333",
				"fontStyle": "bold strikethrough"
			}
		},
		{
			"scope": [
				"keyword.other.DML.sql"
			],
			"settings": {
				"foreground": "#06B6D4",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"entity.name.function.decorator.python",
				"meta.function.decorator.python"
			],
			"settings": {
				"foreground": "#FBBF24",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"meta.type.annotation",
				"storage.type.annotation"
			],
			"settings": {
				"foreground": "#38BDF8"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#6796E6"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#CD9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#F44747"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#B267E6"
			}
		}
	]
}