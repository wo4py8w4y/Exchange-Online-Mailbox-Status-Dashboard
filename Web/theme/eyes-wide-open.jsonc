		{
			"scope": [
				"markup.heading.markdown entity.name.section.markdown"
			],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"scope": [
				"markup.heading.markdown punctuation.definition.heading.markdown"
