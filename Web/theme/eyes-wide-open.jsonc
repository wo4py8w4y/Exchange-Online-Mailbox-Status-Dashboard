			"settings": {
				"foreground": "#BEB4C4"
			}
		},
		{
			"scope": [
				"markup.inline.raw.string.markdown"
			],
			"settings": {
				"foreground": "#C2EF61",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"punctuation.definition.raw.markdown"
