	"tokenColors": [
		{
			"scope": "comment",
			"settings": {
				"foreground": "#6A7293",
				"fontStyle": "bold italic"
			}
		},
		{
			"scope": [
				"comment storage.type"
			],
			"settings": {
				"foreground": "#6A7293"
			}
		},
		{
			"scope": [
				"comment entity.name.type"
			],
			"settings": {
				"foreground": "#CCD3E0"
			}
		},
		{
			"scope": [
				"comment variable.other"
			],
			"settings": {
				"foreground": "#99A7C2",
				"fontStyle": "underline"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#FFEC60"
			}
		},
		{
			"scope": [
				"string.quoted"
			],
			"settings": {
				"foreground": "#FDFFD1"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#D597FF"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#D597FF"
			}
		},
		{
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#D597FF"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"fontStyle": ""
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#FF6E99",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"meta.tag",
				"declaration.tag"
			],
