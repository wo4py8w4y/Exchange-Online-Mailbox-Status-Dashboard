		//"window.inactiveBorder": null
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#4A6A5D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#4A8C5C"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.numeric.integer",
				"constant.numeric.float",
				"constant.numeric.hex",
				"constant.numeric.octal"
			],
			"settings": {
				"foreground": "#D4A017"
			}
		},
		{
			"scope": [
				"constant.language.boolean",
				"constant.language.true",
				"constant.language.false"
			],
			"settings": {
				"foreground": "#D4A017"
			}
		},
		{
			"scope": [
				"constant",
				"constant.language"
			],
			"settings": {
				"foreground": "#5A9A8C"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical",
				"keyword.other"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison"
			],
			"settings": {
				"foreground": "#5A7A6D"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"entity.name.class",
				"entity.name.type.class"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#8A5A8A"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#8FB3A5"
			}
		},
		{
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#C97A4A"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#5A9A8C"
			}
		},
		{
			"scope": [
				"punctuation"
			],
			"settings": {
				"foreground": "#5A7A6D"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#C92A2A"
			}
		},
		{
			"scope": [
				"comment.block.documentation",
				"comment.block.javadoc"
			],
			"settings": {
				"foreground": "#5A7A6D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"string.escape"
			],
			"settings": {
				"foreground": "#659D74"
			}
		},
		{
			"scope": [
				"entity.name.function.definition"
			],
			"settings": {
				"foreground": "#8A5A8A"
			}
		},
		{
			"scope": [
				"entity.name.function.member",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#8A5A8A"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#8FB3A5"
			}
		},
		{
			"scope": [
				"punctuation.definition.block",
				"punctuation.brackets",
				"punctuation.section",
				"meta.brace"
			],
			"settings": {
				"foreground": "#8E8E93"
			}
		},
		{
			"scope": [
				"meta.preprocessor",
				"keyword.control.directive"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"entity.name.module"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator"
			],
			"settings": {
				"foreground": "#8A5A8A"
			}
		},
		{
			"scope": [
				"entity.name.label"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"entity.name.type.enum",
				"entity.name.type.enum-member"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#8FB3A5",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#8FB3A5",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#8FB3A5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code",
				"markup.raw"
			],
			"settings": {
				"foreground": "#4A8C5C"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#5A7A6D",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.list punctuation.definition.list"
			],
			"settings": {
				"foreground": "#E85D04"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#4A8C5C"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#C92A2A"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#D4A017"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#C92A2A"
			}
		},
		{
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#C97A4A"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"support.type.property-name.css"
			],
			"settings": {
				"foreground": "#8FB3A5"
			}
		},
		{
			"scope": [
				"support.constant.property-value.css"
			],
			"settings": {
				"foreground": "#3A7A8C"
			}
		},
		{
			"scope": [
				"keyword.other.unit.css"
			],
			"settings": {
				"foreground": "#D4A017"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#6796E6"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#CD9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#F44747"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#B267E6"
			}
		}
	]
}